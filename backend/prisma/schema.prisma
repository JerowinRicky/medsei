datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// MULTI-TENANCY & ORGANIZATIONS
// -------------------------------------------------------------
model Organization {
  id                  String             @id @default(uuid())
  name                String
  slug                String             @unique
  code                String?            @unique
  licenseType         String             @default("ENTERPRISE")
  status              String             @default("ACTIVE")
  logoUrl             String?
  contactEmail        String?
  contactPhone        String?
  address             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  users               User[]
  roles               Role[]
  departments         Department[]
  hospitals           Hospital[]
  projects            Project[]
  patients            Patient[]
  tasks               Task[]
  hmsConnections      HmsConnection[]
  summaryTemplates    SummaryTemplate[]
  auditLogs           AuditLog[]
  systemSettings      SystemSetting[]
  notifications       Notification[]

  @@map("organizations")
}

model Hospital {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  code            String
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  phone           String?
  email           String?
  status          String         @default("ACTIVE")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments     Department[]
  projects        Project[]
  patients        Patient[]

  @@unique([organizationId, code])
  @@map("hospitals")
}

model Department {
  id              String         @id @default(uuid())
  organizationId  String
  hospitalId      String?
  name            String
  code            String
  description     String?
  status          String         @default("ACTIVE")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hospital        Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  projects        Project[]
  encounters      Encounter[]

  @@unique([organizationId, code])
  @@map("departments")
}

// -------------------------------------------------------------
// USERS & RBAC
// -------------------------------------------------------------
model User {
  id                  String         @id @default(uuid())
  organizationId      String
  email               String         @unique
  passwordHash        String
  firstName           String
  lastName            String
  title               String?
  phone               String?
  roleId              String
  status              String         @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED, LOCKED
  failedLoginAttempts Int            @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  mfaEnabled          Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                Role           @relation(fields: [roleId], references: [id])
  assignedTasks       Task[]         @relation("TaskAssignee")
  reviewedTasks       Task[]         @relation("TaskReviewer")
  createdTasks        Task[]         @relation("TaskCreator")
  auditLogs           AuditLog[]
  notifications       Notification[]
  uploadedDocuments   Document[]     @relation("DocumentUploader")
  approvedSummaries   GeneratedSummary[] @relation("SummaryApprover")

  @@index([organizationId, email])
  @@map("users")
}

model Role {
  id              String         @id @default(uuid())
  organizationId  String?
  name            String
  code            String
  description     String?
  isSystem        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id              String         @id @default(uuid())
  code            String         @unique
  name            String
  module          String
  description     String?
  createdAt       DateTime       @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id              String         @id @default(uuid())
  roleId          String
  permissionId    String
  createdAt       DateTime       @default(now())

  role            Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// -------------------------------------------------------------
// PROJECTS & CONFIGURABLE WORKFLOW TYPES
// -------------------------------------------------------------
model Project {
  id              String         @id @default(uuid())
  organizationId  String
  hospitalId      String?
  departmentId    String?
  name            String
  description     String?
  dataSource      String         @default("HMS_AND_DOCUMENT") // HMS, DOCUMENT, HMS_AND_DOCUMENT
  status          String         @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hospital        Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectTypes    ProjectType[]
  tasks           Task[]

  @@index([organizationId, status])
  @@map("projects")
}

model ProjectType {
  id                      String         @id @default(uuid())
  projectId               String
  name                    String         // Discharge Summary, Emergency Summary, Transfer Summary, Operative Summary
  code                    String
  description             String?
  dataSource              String         @default("HMS_AND_DOCUMENT")
  requiresDocumentReview  Boolean        @default(true)
  requiresAiValidation    Boolean        @default(true)
  requiresDoctorApproval  Boolean        @default(true)
  requiresFinalApproval   Boolean        @default(true)
  active                  Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  project                 Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectDocumentTypes    ProjectDocumentType[]
  tasks                   Task[]
  summaryTemplates        SummaryTemplate[]

  @@unique([projectId, code])
  @@map("project_types")
}

model DocumentType {
  id                  String         @id @default(uuid())
  organizationId      String?
  name                String         // Lab Report, Discharge Note, Prescription, Operative Note, Radiology Report
  code                String         @unique
  description         String?
  allowedExtensions   String         @default("pdf,jpg,jpeg,png,tiff")
  maxFileSizeMb       Int            @default(25)
  ocrRequired         Boolean        @default(true)
  aiExtractionRequired Boolean       @default(true)
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  projectDocumentTypes ProjectDocumentType[]
  documents           Document[]

  @@map("document_types")
}

model ProjectDocumentType {
  id              String         @id @default(uuid())
  projectTypeId   String
  documentTypeId  String
  isRequired      Boolean        @default(false)
  priority        Int            @default(1)

  projectType     ProjectType    @relation(fields: [projectTypeId], references: [id], onDelete: Cascade)
  documentType    DocumentType   @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([projectTypeId, documentTypeId])
  @@map("project_document_types")
}

// -------------------------------------------------------------
// PATIENTS, ENCOUNTERS & ADMISSIONS (NORMALIZED CLINICAL REPOSITORY)
// -------------------------------------------------------------
model Patient {
  id              String         @id @default(uuid())
  organizationId  String
  hospitalId      String?
  externalId      String?
  uhid            String
  firstName       String
  lastName        String
  fullName        String
  dob             DateTime?
  age             Int?
  gender          String         // MALE, FEMALE, OTHER, UNKNOWN
  phone           String?
  email           String?
  address         String?
  bloodGroup      String?
  source          String         @default("HMS") // HMS, DOCUMENT, MANUAL
  dataClassification String      @default("HIGHLY_SENSITIVE")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hospital        Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  encounters      Encounter[]
  tasks           Task[]

  @@unique([organizationId, uhid])
  @@index([organizationId, externalId])
  @@index([organizationId, fullName])
  @@map("patients")
}

model Encounter {
  id                  String         @id @default(uuid())
  patientId           String
  departmentId        String?
  encounterNumber     String
  admissionDate       DateTime
  dischargeDate       DateTime?
  encounterType       String         @default("INPATIENT") // INPATIENT, OUTPATIENT, EMERGENCY
  attendingDoctorName String?
  roomNumber          String?
  bedNumber           String?
  status              String         @default("ACTIVE") // ACTIVE, DISCHARGED, CANCELLED
  hmsRawData          Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  patient             Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  department          Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tasks               Task[]

  @@unique([patientId, encounterNumber])
  @@map("encounters")
}

// -------------------------------------------------------------
// HMS INTEGRATION ENGINE
// -------------------------------------------------------------
model HmsConnection {
  id                  String         @id @default(uuid())
  organizationId      String
  hospitalName        String
  hmsName             String         // Epic, Cerner, Meditech, Generic REST, Mock HMS
  integrationType     String         @default("REST") // REST, FHIR, HL7, MOCK
  baseUrl             String
  authType            String         @default("BEARER") // API_KEY, BEARER, OAUTH2, BASIC, NONE
  apiKeyEncrypted     String?
  clientId            String?
  clientSecretEncrypted String?
  username            String?
  passwordEncrypted   String?
  tokenUrl            String?
  timeoutMs           Int            @default(15000)
  retryCount          Int            @default(3)
  active              Boolean        @default(true)
  lastTestedAt        DateTime?
  lastTestStatus      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoints           HmsEndpoint[]
  fieldMappings       HmsFieldMapping[]

  @@index([organizationId, active])
  @@map("hms_connections")
}

model HmsEndpoint {
  id                  String         @id @default(uuid())
  hmsConnectionId     String
  name                String         // Patient Search, Patient Details, Encounter, Admission, Diagnosis, Lab, Medication
  endpointType        String         // PATIENT_SEARCH, PATIENT_DETAILS, ENCOUNTER, ADMISSION, CLINICAL_DATA
  httpMethod          String         @default("GET")
  path                String
  requestHeaders      Json?
  defaultQueryParams  Json?
  responseRootPath    String?
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  hmsConnection       HmsConnection  @relation(fields: [hmsConnectionId], references: [id], onDelete: Cascade)

  @@unique([hmsConnectionId, endpointType])
  @@map("hms_endpoints")
}

model HmsFieldMapping {
  id                  String         @id @default(uuid())
  hmsConnectionId     String
  sourcePath          String         // e.g. "patient.demographics.name"
  targetField         String         // e.g. "patient.fullName"
  dataType            String         @default("STRING") // STRING, NUMBER, DATE, OBJECT, ARRAY
  transformation      String?        // NONE, UPPERCASE, DATE_ISO, CUSTOM
  isRequired          Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  hmsConnection       HmsConnection  @relation(fields: [hmsConnectionId], references: [id], onDelete: Cascade)

  @@unique([hmsConnectionId, targetField])
  @@map("hms_field_mappings")
}

// -------------------------------------------------------------
// TASKS & WORKFLOW EXECUTION
// -------------------------------------------------------------
model Task {
  id                  String         @id @default(uuid())
  organizationId      String
  projectId           String
  projectTypeId       String
  patientId           String?
  encounterId         String?
  taskNumber          String         @unique
  dataSource          String         // HMS, DOCUMENT, HMS_AND_DOCUMENT
  status              String         @default("DRAFT")
  assignedUserId      String?
  reviewerUserId      String?
  createdById         String?
  
  // Unified Clinical Data payload stored as verified normalized JSON
  unifiedClinicalData Json?
  conflictData        Json?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project        @relation(fields: [projectId], references: [id])
  projectType         ProjectType    @relation(fields: [projectTypeId], references: [id])
  patient             Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  encounter           Encounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  assignedUser        User?          @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  reviewerUser        User?          @relation("TaskReviewer", fields: [reviewerUserId], references: [id])
  createdByUser       User?          @relation("TaskCreator", fields: [createdById], references: [id])

  documents           Document[]
  generatedSummaries  GeneratedSummary[]
  auditLogs           AuditLog[]

  @@index([organizationId, status])
  @@index([organizationId, patientId])
  @@map("tasks")
}

// -------------------------------------------------------------
// DOCUMENTS & AI/OCR PIPELINE
// -------------------------------------------------------------
model Document {
  id                  String         @id @default(uuid())
  taskId              String
  documentTypeId      String
  fileName            String
  originalFileName    String
  mimeType            String
  fileSize            Int
  storageKey          String
  checksum            String
  status              String         @default("UPLOADED") // UPLOADED, OCR_QUEUED, OCR_PROCESSING, OCR_COMPLETED, AI_EXTRACTION_COMPLETED, FAILED
  ocrText             String?        @db.Text
  ocrConfidence       Float?
  extractedData       Json?
  uploadedById        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  task                Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  documentType        DocumentType   @relation(fields: [documentTypeId], references: [id])
  uploadedBy          User?          @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([taskId, status])
  @@map("documents")
}

// -------------------------------------------------------------
// SUMMARY TEMPLATES & GENERATION
// -------------------------------------------------------------
model SummaryTemplate {
  id                  String         @id @default(uuid())
  organizationId      String
  projectTypeId       String?
  name                String
  code                String
  description         String?
  status              String         @default("DRAFT") // DRAFT, REVIEW, APPROVED, PUBLISHED, ARCHIVED
  version             Int            @default(1)
  isDefault           Boolean        @default(false)
  
  // Array of sections containing header, order, templateContent with handlebars / {{variable}} tags
  sections            Json
  headerHtml          String?
  footerHtml          String?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectType         ProjectType?   @relation(fields: [projectTypeId], references: [id], onDelete: SetNull)
  generatedSummaries  GeneratedSummary[]

  @@unique([organizationId, code, version])
  @@map("summary_templates")
}

model GeneratedSummary {
  id                  String         @id @default(uuid())
  taskId              String
  summaryTemplateId   String
  templateVersion     Int
  revisionNumber      Int            @default(1)
  contentHtml         String         @db.Text
  contentJson         Json
  status              String         @default("DRAFT") // DRAFT, GENERATED, REVIEW_REQUIRED, REVIEWED, APPROVED, FINALIZED
  approvedById        String?
  approvedAt          DateTime?
  digitalSignatureRef String?
  isImmutable         Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  task                Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  summaryTemplate     SummaryTemplate @relation(fields: [summaryTemplateId], references: [id])
  approvedBy          User?          @relation("SummaryApprover", fields: [approvedById], references: [id])

  @@index([taskId, revisionNumber])
  @@map("generated_summaries")
}

// -------------------------------------------------------------
// AUDIT LOGS, NOTIFICATIONS & SYSTEM SETTINGS
// -------------------------------------------------------------
model AuditLog {
  id                  String         @id @default(uuid())
  organizationId      String
  userId              String?
  userEmail           String?
  userRole            String?
  action              String         // PATIENT_VIEWED, DOCUMENT_UPLOADED, SUMMARY_GENERATED, etc.
  entity              String         // Patient, Task, Document, Summary, HMSConnection, Template
  entityId            String?
  taskId              String?
  ipAddress           String?
  userAgent           String?
  oldValue            Json?
  newValue            Json?
  reason              String?
  createdAt           DateTime       @default(now())

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  task                Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([organizationId, action])
  @@index([organizationId, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id                  String         @id @default(uuid())
  organizationId      String
  userId              String
  type                String         // INFO, SUCCESS, WARNING, ERROR
  title               String
  message             String
  referenceEntity     String?
  referenceEntityId   String?
  isRead              Boolean        @default(false)
  readAt              DateTime?
  createdAt           DateTime       @default(now())

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model SystemSetting {
  id                  String         @id @default(uuid())
  organizationId      String
  category            String         // AI, OCR, WORKFLOW, SECURITY, HMS, RETENTION
  key                 String
  value               String         @db.Text
  isSecret            Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, category, key])
  @@map("system_settings")
}

